APP_ENV=local
HTTP_PORT=18080
POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:15432/redcart?sslmode=disable
REDIS_ADDR=127.0.0.1:6380
# 限流策略（按类别，令牌桶）：RATE 为每秒补充令牌数（QPS），BURST 为桶容量。
# RATE_LIMIT_WRITE_* 控制订单创建、支付等关键写接口（默认 5 QPS / 桶容量 10）。
RATE_LIMIT_WRITE_RATE=5
RATE_LIMIT_WRITE_BURST=10
# RATE_LIMIT_AI_* 控制 AI 生成接口（默认 1 QPS / 桶容量 3）。
RATE_LIMIT_AI_RATE=1
RATE_LIMIT_AI_BURST=3
RABBITMQ_ADDR=amqp://redcart:redcart@127.0.0.1:5672/
RABBITMQ_EXCHANGE=redcart.events
AI_PROVIDER=mock
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_APPLICATION_NAME=redcart.backend
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
PYROSCOPE_TENANT_ID=
PYROSCOPE_MUTEX_PROFILE_FRACTION=
PYROSCOPE_BLOCK_PROFILE_RATE=
